# Copy to deploy/.env.api on the VPS (chmod 600). Never commit the real file.

# Postgres container reachable on the shared docker network by its service/container name.
DATABASE_URL=postgresql://crypz:CHANGE_ME@postgres:5432/crypz?schema=public

# openssl rand -base64 32   (AES-256-GCM master key for exchange credentials; back it up offline —
# losing it means every stored key must be re-entered)
CREDENTIALS_KEY=
# openssl rand -base64 32
BETTER_AUTH_SECRET=

BETTER_AUTH_URL=https://api.example.com
WEB_ORIGIN=https://app.example.com
# Parent domain shared by app. and api., so the session cookie reaches both.
COOKIE_DOMAIN=example.com

# Optional: AI insights on the dashboard. Key from https://aistudio.google.com/apikey; leave empty to keep the
# panel on fixed-rule readouts. GEMINI_MODEL overrides the default model id.
GEMINI_API_KEY=
GEMINI_MODEL=
