# Local development. Copy to .env at the repo root.

# --- database (brew postgresql@16 locally; see deploy/README.md for the VPS) ---
DATABASE_URL=postgresql://crypz:password@localhost:5432/crypz?schema=public

# --- api (packages/api) ---
# openssl rand -base64 32 — AES-256-GCM master key for exchange credentials. Never in the DB, never committed.
CREDENTIALS_KEY=
# openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001
WEB_ORIGIN=http://localhost:3000

# --- web (packages/web) ---
VITE_API_URL=http://localhost:3001

# --- optional: one-off import of an existing OKX key into your account ---
# pnpm --filter @crypz/api import-okx-env you@domain.com   (then delete these three)
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
OKX_DEMO=0
